➤ generalInformation.js

import { LightningElement, api, wire } from 'lwc';
import getRecordInfo from '@salesforce/apex/GeneralInfoController.getRecordInfo';

export default class GeneralInformation extends LightningElement {
  @api recordId;
  recordData;
  error;

  @wire(getRecordInfo, { recordId: '$recordId' })
  wiredRecord({ data, error }) {
    if (data) {
      this.recordData = data;
      this.error = null;
    } else if (error) {
      this.error = error;
      this.recordData = null;
    }
  }
}


