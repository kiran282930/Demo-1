✅ Step 3: Create the Parent LWC: dataTableWithDropdown

➤ dataTableWithDropdown.html

<template>
  <table class="slds-table slds-table_bordered slds-table_cell-buffer">
    <thead>
      <tr>
        <th></th>
        <th>Name</th>
      </tr>
    </thead>
    <tbody>
      <template for:each={records} for:item="record">
        <tr key={record.id}>
          <td>
            <lightning-button-icon
              icon-name={record.id === expandedId ? 'utility:chevrondown' : 'utility:chevronright'}
              alternative-text="Toggle"
              onclick={handleToggle}
              data-id={record.id}>
            </lightning-button-icon>
          </td>
          <td>{record.name}</td>
        </tr>

        <template if:true={record.showDetails}>
          <tr key={record.id + '-details'}>
            <td colspan="2">
              <c-general-information record-id={record.id}></c-general-information>
            </td>
          </tr>
        </template>
      </template>
    </tbody>
  </table>
</template>


