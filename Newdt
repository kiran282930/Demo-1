➤ dataTableWithDropdown.js

import { LightningElement, track } from 'lwc';

export default class DataTableWithDropdown extends LightningElement {
  @track records = [
    { id: '001XXXXXXXXXXXXAAA', name: 'Acme Corp', showDetails: false },
    { id: '001XXXXXXXXXXXXAAB', name: 'Global Tech', showDetails: false }
  ];

  expandedId;

  handleToggle(event) {
    const clickedId = event.currentTarget.dataset.id;

    this.records = this.records.map(record => ({
      ...record,
      showDetails: record.id === clickedId ? !record.showDetails : false
    }));

    this.expandedId = this.records.find(r => r.showDetails)?.id || null;
  }
}

> 🧠 Note: Replace the id values with real Account record Ids from your org.




